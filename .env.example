# Plantilla de variables de entorno — chatbot TALENTUM GROUP
# Copia este archivo como .env y completa los valores. Nunca subas el .env a git.

# Token de verificación del webhook. Lo inventas tú (cadena secreta larga);
# debe coincidir EXACTAMENTE con el "Verify token" que registres en Meta.
VERIFY_TOKEN=

# Token de acceso PERMANENTE de tu app de Meta
# (developers.facebook.com → tu app → WhatsApp → API Setup → System User).
WHATSAPP_TOKEN=

# "Phone number ID" del número de WhatsApp Business
# (misma pantalla de API Setup, campo "Phone number ID").
PHONE_NUMBER_ID=

# Versión de la Graph API (opcional; el código usa v21.0 por defecto).
GRAPH_API_VERSION=v21.0

# API keys de Google AI Studio (https://aistudio.google.com/) — cerebro conversacional.
# Rotación automática: separa múltiples claves con comas. El bot reparte las
# llamadas en round-robin y pone en pausa la clave que agote su cupo (60 s)
# o resulte inválida (1 h). Así el cupo no se agota con muchas solicitudes.
GEMINI_API_KEYS=clave1,clave2,clave3
# (Respaldo) Una sola clave también funciona:
# GEMINI_API_KEY=

# Modelo de Gemini (opcional; por defecto gemini-2.0-flash).
GEMINI_MODEL=gemini-2.0-flash

# Ruta del SQLite de conversaciones (opcional; por defecto ./conversations.db).
# DB_PATH=
